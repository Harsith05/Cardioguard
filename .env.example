# Copy to .env (same folder as docker-compose.yml). Both Docker Compose and the
# Python code read it, so there is no need to set variables in each terminal.
# Variables set in the terminal still take priority over this file.
# If POSTGRES_PORT is 5433, the port in DATABASE_URL must be 5433 too.
POSTGRES_USER=cardio
POSTGRES_PASSWORD=cardio
POSTGRES_PORT=5432          # use 5433 if a Windows Postgres already uses 5432
GRAFANA_PASSWORD=admin

DATABASE_URL=postgresql+psycopg2://cardio:cardio@localhost:5432/cardio
MONGO_URI=mongodb://localhost:27017
MONGO_DB=cardioguard
MODEL_PATH=models/model.joblib
MODEL_META_PATH=models/model_meta.json

PUSHGATEWAY_URL=localhost:9091   # drift job pushes results here
# optional Slack/Discord/Teams webhook
ALERT_WEBHOOK_URL=
CHAOS_ENABLED=0                  # 1 = allow /debug/chaos fault injection (testing only)
PSEUDO_LABEL_ENABLED=1           # Phase 5: pseudo-label unconfirmed patients after each drift check
DRIFT_EVERY_MINUTES=60

# ---- Phase 6: self-healing ----
# For Python on your computer (Docker services set their own values).
MLFLOW_TRACKING_URI=http://localhost:5000   # empty = no registry, serve models/model.joblib
PROMETHEUS_URL=http://localhost:9090        # canary check reads model errors here
# drift job on your computer: http://localhost:8080 to start the DAG
AIRFLOW_URL=
DEPLOYMENT_POLL_SECONDS=15                  # how fast the API follows a canary/promotion
# Docker settings
MLFLOW_PORT=5000
AIRFLOW_PORT=8080
AIRFLOW_PASSWORD=admin                      # Airflow UI login: admin / this
AIRFLOW_SECRET=change-me-to-a-long-random-string
# set to require X-Admin-Token for approve/reject/rollback
ADMIN_TOKEN=
